+        }
+
+        /// <summary>Có cờ <paramref name="bit"/> (RoleModes.View/Edit/Add/Remove) trên chức năng tên này không.</summary>
+        public bool Can(string functionName, int bit)
+        {
+            return (ModeByName(functionName) & bit) == bit;
+        }
     }
 }
