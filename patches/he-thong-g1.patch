+++ b/Kazuko_FnB/Data/ConfigRepository.cs
@@ -0,0 +1,264 @@
+using System;
+using System.Collections.Generic;
+using System.Data;
+using FirebirdSql.Data.FirebirdClient;
+
+namespace Kazuko_FnB.Data
+{
+    /// <summary>Kiểu điều khiển của một khóa cấu hình (SCONFIG.CONTROLTYPE).</summary>
+    public enum ConfigControl
+    {
+        Number = 3,
+        Text = 5,
+        MultiLine = 6,
+        Image = 7,
+        Lookup = 8,
+        Check = 9,
+        Combo = 10
+    }
+
+    /// <summary>Một dòng SCONFIG hiển thị trên màn Cấu hình.</summary>
+    public sealed class ConfigItem
+    {
+        public string Id { get; set; }
+        public string Name { get; set; }
+        public string Caption { get; set; }
+        public string GroupId { get; set; }
+        /// <summary>0 = ô chính; 30 = ô phụ nằm dưới ô cha ngay trước nó.</summary>
+        public int Tab { get; set; }
+        public int SortOrder { get; set; }
+        /// <summary>1 chuỗi, 3 số, 5 blob (SCONFIG.DATATYPE).</summary>
+        public int DataType { get; set; }
+        public int ControlType { get; set; }
+        public int IntValue { get; set; }
+        public decimal DecimalValue { get; set; }
+        public string TextValue { get; set; }
+        public string RefTableId { get; set; }
+        public string MoreDetail { get; set; }
+        /// <summary>Combo: danh sách mục (mỗi dòng một mục; giá trị lưu = chỉ số). Lookup: bộ lọc dạng CỘT = 'guid'.</summary>
+        public string OtherConfig { get; set; }
+
+        public ConfigControl Control
+        {
+            get { return (ConfigControl)ControlType; }
+        }
+
+        public string[] ComboItems
+        {
+            get
+            {
+                if (string.IsNullOrEmpty(OtherConfig))
+                    return new string[0];
+                return OtherConfig.Replace("\r\n", "\n").Split(new[] { '\n' }, StringSplitOptions.None);
+            }
+        }
+    }
+
+    public sealed class ConfigGroup
+    {
+        public string Id { get; set; }
+        public string Name { get; set; }
+        public string SortOrder { get; set; }
+    }
+
+    /// <summary>Giá trị gọn của một khóa cho lớp SystemConfig.</summary>
+    public sealed class ConfigValue
+    {
+        public int DataType { get; set; }
+        public int IntValue { get; set; }
+        public decimal DecimalValue { get; set; }
+        public string TextValue { get; set; }
+    }
+
+    /// <summary>Một thay đổi cần ghi vào SCONFIG (theo NAME).</summary>
+    public sealed class ConfigChange
+    {
+        public string Name { get; set; }
+        public int DataType { get; set; }
+        public int IntValue { get; set; }
+        public decimal DecimalValue { get; set; }
+        public string TextValue { get; set; }
+        public byte[] BlobValue { get; set; }
+        public bool IsBlob { get; set; }
+    }
+
+    /// <summary>Đọc/ghi SCONFIG và SCONFIGGROUP (bảng khóa–giá trị; khóa = NAME).</summary>
+    public sealed class ConfigRepository
+    {
+        private static readonly HashSet<string> HiddenGroups = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
+        {
+            "Ẩn", "Ứng dụng", "Mẫu hóa đơn", "Số phiếu"
+        };
+
+        private readonly string _databasePath;
+
+        public ConfigRepository(string databasePath)
+        {
+            _databasePath = databasePath;
+        }
+
+        /// <summary>Mọi khóa → giá trị (cho SystemConfig). Bỏ qua cột blob.</summary>
+        public Dictionary<string, ConfigValue> LoadValues()
+        {
+            var map = new Dictionary<string, ConfigValue>(StringComparer.Ordinal);
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT NAME, DATATYPE, INTVALUE, DECIMALVALUE, TEXTVALUE FROM SCONFIG WHERE NAME IS NOT NULL");
+                foreach (DataRow r in dt.Rows)
+                {
+                    string name = DbHelper.Str(r[0]);
+                    if (string.IsNullOrEmpty(name))
+                        continue;
+                    map[name] = new ConfigValue
+                    {
+                        DataType = DbHelper.Int(r[1]),
+                        IntValue = DbHelper.Int(r[2]),
+                        DecimalValue = DbHelper.Dec(r[3]),
+                        TextValue = DbHelper.Str(r[4])
+                    };
+                }
+            }
+            return map;
+        }
+
+        /// <summary>Nhóm hiển thị trên màn Cấu hình (đang dùng, trừ nhóm "Ẩn"), theo thứ tự.</summary>
+        public List<ConfigGroup> LoadVisibleGroups()
+        {
+            var list = new List<ConfigGroup>();
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT ID, NAME, SORTORDER FROM SCONFIGGROUP WHERE STATUS = 30 ORDER BY SORTORDER, NAME");
+                foreach (DataRow r in dt.Rows)
+                {
+                    string name = DbHelper.Str(r[1]);
+                    // "Ẩn": cờ nội bộ. "Ứng dụng": không có trên màn gốc. "Mẫu hóa đơn": khu của nhà phát triển (khóa bằng
+                    // mật khẩu). "Số phiếu": định dạng đánh số chứng từ — làm riêng vì ảnh hưởng đánh số hóa đơn.
+                    if (HiddenGroups.Contains(name))
+                        continue;
+                    list.Add(new ConfigGroup { Id = DbHelper.Str(r[0]), Name = name, SortOrder = DbHelper.Str(r[2]) });
+                }
+            }
+            return list;
+        }
+
+        /// <summary>Các khóa có nhãn (CAPTION) thuộc nhóm hiển thị, theo nhóm/tab/thứ tự. Khóa nội bộ (không nhãn) bị loại.</summary>
+        public List<ConfigItem> LoadItems()
+        {
+            var list = new List<ConfigItem>();
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT ID, NAME, CAPTION, SCONFIGGROUPID, TAB, SORTORDER, DATATYPE, CONTROLTYPE, " +
+                    "INTVALUE, DECIMALVALUE, TEXTVALUE, REFTABLEID, MOREDETAIL, OTHERCONFIG " +
+                    "FROM SCONFIG WHERE CAPTION IS NOT NULL AND CAPTION <> '' AND SCONFIGGROUPID IS NOT NULL " +
+                    "ORDER BY SCONFIGGROUPID, SORTORDER");
+                foreach (DataRow r in dt.Rows)
+                {
+                    list.Add(new ConfigItem
+                    {
+                        Id = DbHelper.Str(r[0]),
+                        Name = DbHelper.Str(r[1]),
+                        Caption = DbHelper.Str(r[2]),
+                        GroupId = DbHelper.Str(r[3]),
+                        Tab = DbHelper.Int(r[4]),
+                        SortOrder = DbHelper.Int(r[5]),
+                        DataType = DbHelper.Int(r[6]),
+                        ControlType = DbHelper.Int(r[7]),
+                        IntValue = DbHelper.Int(r[8]),
+                        DecimalValue = DbHelper.Dec(r[9]),
+                        TextValue = DbHelper.Str(r[10]),
+                        RefTableId = DbHelper.Str(r[11]),
+                        MoreDetail = DbHelper.Str(r[12]),
+                        OtherConfig = DbHelper.Str(r[13])
+                    });
+                }
+            }
+            return list;
+        }
+
+        private static readonly System.Text.RegularExpressions.Regex IdentifierRx =
+            new System.Text.RegularExpressions.Regex("^[A-Za-z][A-Za-z0-9_]*$");
+        private static readonly System.Text.RegularExpressions.Regex FilterRx =
+            new System.Text.RegularExpressions.Regex("^[A-Za-z][A-Za-z0-9_]* = '[0-9a-fA-F-]{36}'$");
+
+        /// <summary>
+        /// Danh sách chọn (ID, NAME) cho ô kiểu "Lookup": bảng lấy từ STABLEDESC theo REFTABLEID, có thể lọc theo
+        /// OtherConfig dạng CỘT = 'guid'. Tên bảng/bộ lọc không đúng khuôn thì bỏ qua (siêu dữ liệu lạ không được chạy).
+        /// </summary>
+        public List<KeyValuePair<string, string>> LoadLookup(string refTableId, string filter)
+        {
+            var list = new List<KeyValuePair<string, string>>();
+            if (string.IsNullOrEmpty(refTableId))
+                return list;
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                string table = DbHelper.Str(DbHelper.Scalar(conn, null, "SELECT NAME FROM STABLEDESC WHERE ID = @I", "@I", refTableId));
+                if (string.IsNullOrEmpty(table) || !IdentifierRx.IsMatch(table))
+                    return list;
+                string where = !string.IsNullOrEmpty(filter) && FilterRx.IsMatch(filter.Trim()) ? " WHERE " + filter.Trim() : "";
+                DataTable dt;
+                try
+                {
+                    dt = DbHelper.Table(conn, null, "SELECT ID, NAME FROM " + table + where + " ORDER BY NAME");
+                }
+                catch (FbException)
+                {
+                    return list;
+                }
+                foreach (DataRow r in dt.Rows)
+                    list.Add(new KeyValuePair<string, string>(DbHelper.Str(r[0]), DbHelper.Str(r[1]) ?? ""));
+            }
+            return list;
+        }
+
+        /// <summary>Ảnh (blob) của một khóa, ví dụ Logo. Null nếu chưa có.</summary>
+        public byte[] LoadBlob(string name)
+        {
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                object v = DbHelper.Scalar(conn, null, "SELECT BLOBVALUE FROM SCONFIG WHERE NAME = @N", "@N", name);
+                return v as byte[];
+            }
+        }
+
+        /// <summary>
+        /// Ghi các thay đổi trong MỘT transaction, theo NAME. Khóa chưa có dòng thì bỏ qua (không tự tạo).
+        /// Trả về số khóa đã ghi.
+        /// </summary>
+        public int Save(IEnumerable<ConfigChange> changes, string userId)
+        {
+            int written = 0;
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DateTime now = DbHelper.Now();
+                foreach (ConfigChange c in changes)
+                {
+                    int n;
+                    if (c.IsBlob)
+                    {
+                        n = DbHelper.Exec(conn, tx,
+                            "UPDATE SCONFIG SET BLOBVALUE = @V, TIMEMODIFIED = @T, USERMODIFIEDID = @U WHERE NAME = @N",
+                            "@V", c.BlobValue, "@T", now, "@U", userId, "@N", c.Name);
+                    }
+                    else if (c.DataType == 1)
+                    {
+                        n = DbHelper.Exec(conn, tx,
+                            "UPDATE SCONFIG SET TEXTVALUE = @V, TIMEMODIFIED = @T, USERMODIFIEDID = @U WHERE NAME = @N",
+                            "@V", c.TextValue, "@T", now, "@U", userId, "@N", c.Name);
+                    }
+                    else
+                    {
+                        n = DbHelper.Exec(conn, tx,
+                            "UPDATE SCONFIG SET INTVALUE = @V, DECIMALVALUE = @D, TIMEMODIFIED = @T, USERMODIFIEDID = @U WHERE NAME = @N",
+                            "@V", c.IntValue, "@D", c.DecimalValue, "@T", now, "@U", userId, "@N", c.Name);
+                    }
+                    if (n > 0)
+                        written++;
+                }
+            });
+            return written;
+        }
+    }
+}
diff --git a/Kazuko_FnB/Data/DbHelper.cs b/Kazuko_FnB/Data/DbHelper.cs
new file mode 100644
index 0000000..7b92a72
--- /dev/null
+++ b/Kazuko_FnB/Data/DbHelper.cs
@@ -0,0 +1,107 @@
+using System;
+using System.Data;
+using FirebirdSql.Data.FirebirdClient;
+
+namespace Kazuko_FnB.Data
+{
+    /// <summary>
+    /// Tiện ích SQL viết tay dùng chung cho các repository ghi dữ liệu (không ORM).
+    /// Tham số truyền dạng cặp: "@Ten", giaTri, "@Ten2", giaTri2, ... (null → NULL).
+    /// SQL luôn tham số hóa; chỉ nằm trong lớp Data.
+    /// </summary>
+    public static class DbHelper
+    {
+        /// <summary>ID mới (GUID chuỗi chữ thường, đúng dạng ID trong DATA.FDB).</summary>
+        public static string NewId()
+        {
+            return Guid.NewGuid().ToString();
+        }
+
+        /// <summary>Giờ ghi vào cột TIMECREATED/TIMEMODIFIED (giờ máy, bỏ phần nghìn giây).</summary>
+        public static DateTime Now()
+        {
+            DateTime n = DateTime.Now;
+            return new DateTime(n.Year, n.Month, n.Day, n.Hour, n.Minute, n.Second);
+        }
+
+        public static FbCommand Command(FbConnection conn, FbTransaction tx, string sql, params object[] args)
+        {
+            FbCommand cmd = conn.CreateCommand();
+            cmd.Transaction = tx;
+            cmd.CommandText = sql;
+            if (args != null)
+            {
+                if (args.Length % 2 != 0)
+                    throw new ArgumentException("Tham số SQL phải là cặp tên - giá trị.", "args");
+                for (int i = 0; i < args.Length; i += 2)
+                    cmd.Parameters.AddWithValue((string)args[i], args[i + 1] ?? DBNull.Value);
+            }
+            return cmd;
+        }
+
+        public static int Exec(FbConnection conn, FbTransaction tx, string sql, params object[] args)
+        {
+            using (FbCommand cmd = Command(conn, tx, sql, args))
+                return cmd.ExecuteNonQuery();
+        }
+
+        public static object Scalar(FbConnection conn, FbTransaction tx, string sql, params object[] args)
+        {
+            using (FbCommand cmd = Command(conn, tx, sql, args))
+            {
+                object v = cmd.ExecuteScalar();
+                return v is DBNull ? null : v;
+            }
+        }
+
+        public static DataTable Table(FbConnection conn, FbTransaction tx, string sql, params object[] args)
+        {
+            var dt = new DataTable();
+            using (FbCommand cmd = Command(conn, tx, sql, args))
+            using (var da = new FbDataAdapter(cmd))
+                da.Fill(dt);
+            return dt;
+        }
+
+        /// <summary>Mở kết nối, chạy <paramref name="work"/> trong một transaction; lỗi thì hoàn tác.</summary>
+        public static void InTransaction(string databasePath, Action<FbConnection, FbTransaction> work)
+        {
+            using (FbConnection conn = KazukoConnection.Open(databasePath))
+            using (FbTransaction tx = conn.BeginTransaction())
+            {
+                try
+                {
+                    work(conn, tx);
+                    tx.Commit();
+                }
+                catch
+                {
+                    tx.Rollback();
+                    throw;
+                }
+            }
+        }
+
+        /// <summary>Mở kết nối chỉ đọc một lần cho một nhóm truy vấn.</summary>
+        public static T Read<T>(string databasePath, Func<FbConnection, T> work)
+        {
+            using (FbConnection conn = KazukoConnection.Open(databasePath))
+                return work(conn);
+        }
+
+        public static string Str(object v)
+        {
+            return v == null || v is DBNull ? null : Convert.ToString(v);
+        }
+
+        public static int Int(object v)
+        {
+            return v == null || v is DBNull ? 0 : Convert.ToInt32(v);
+        }
+
+        public static decimal Dec(object v)
+        {
+            return v == null || v is DBNull ? 0m : Convert.ToDecimal(v);
+        }
+    }
+}
diff --git a/Kazuko_FnB/Data/GroupRepository.cs b/Kazuko_FnB/Data/GroupRepository.cs
new file mode 100644
index 0000000..8b687e6
--- /dev/null
+++ b/Kazuko_FnB/Data/GroupRepository.cs
@@ -0,0 +1,105 @@
+using System;
+using System.Collections.Generic;
+using System.Data;
+using FirebirdSql.Data.FirebirdClient;
+
+namespace Kazuko_FnB.Data
+{
+    public sealed class GroupRow
+    {
+        public string Id { get; set; }
+        public string Name { get; set; }
+        public string Note { get; set; }
+        public string ImageId { get; set; }
+    }
+
+    /// <summary>
+    /// Nhóm người dùng (SGROUPUSER). AUTOID = số lớn nhất + 1, SORTORDER = "ZZZ" + số thứ tự 3 chữ số (theo dữ liệu hiện có
+    /// của app gốc), ITEMTYPE = 0, PARENTID/PARENTDIR rỗng.
+    /// </summary>
+    public sealed class GroupRepository
+    {
+        private readonly string _databasePath;
+
+        public GroupRepository(string databasePath)
+        {
+            _databasePath = databasePath;
+        }
+
+        public List<GroupRow> LoadAll()
+        {
+            var list = new List<GroupRow>();
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT ID, NAME, NOTE, SIMAGEID FROM SGROUPUSER WHERE STATUS = 30 ORDER BY SORTORDER, NAME");
+                foreach (DataRow r in dt.Rows)
+                    list.Add(new GroupRow { Id = DbHelper.Str(r[0]), Name = DbHelper.Str(r[1]) ?? "", Note = DbHelper.Str(r[2]) ?? "", ImageId = DbHelper.Str(r[3]) });
+            }
+            return list;
+        }
+
+        public bool IsNameTaken(string name, string excludeId)
+        {
+            string v = (name ?? "").Trim();
+            foreach (GroupRow g in LoadAll())
+                if (g.Id != excludeId && string.Equals(g.Name.Trim(), v, StringComparison.OrdinalIgnoreCase))
+                    return true;
+            return false;
+        }
+
+        public string Save(GroupRow g, string actorId)
+        {
+            bool isNew = string.IsNullOrEmpty(g.Id);
+            string id = isNew ? DbHelper.NewId() : g.Id;
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DateTime now = DbHelper.Now();
+                if (isNew)
+                {
+                    int autoId = DbHelper.Int(DbHelper.Scalar(conn, tx, "SELECT MAX(AUTOID) FROM SGROUPUSER")) + 1;
+                    int seq = 0;
+                    foreach (DataRow r in DbHelper.Table(conn, tx, "SELECT SORTORDER FROM SGROUPUSER").Rows)
+                    {
+                        string so = DbHelper.Str(r[0]) ?? "";
+                        int n;
+                        if (so.StartsWith("ZZZ", StringComparison.Ordinal) && int.TryParse(so.Substring(3), out n))
+                            seq = Math.Max(seq, n);
+                    }
+                    string sort = "ZZZ" + (seq + 1).ToString("000");
+                    DbHelper.Exec(conn, tx,
+                        "INSERT INTO SGROUPUSER (ID, NAME, NOTE, STATUS, USERCREATEDID, TIMECREATED, SORTORDER, PARENTID, PARENTDIR, ITEMTYPE, AUTOID, SIMAGEID) " +
+                        "VALUES (@I, @N, @NO, 30, @A, @T, @S, '', '', 0, @AI, @IM)",
+                        "@I", id, "@N", g.Name.Trim(), "@NO", g.Note ?? "", "@A", actorId, "@T", now, "@S", sort, "@AI", autoId,
+                        "@IM", string.IsNullOrEmpty(g.ImageId) ? null : g.ImageId);
+                }
+                else
+                {
+                    DbHelper.Exec(conn, tx,
+                        "UPDATE SGROUPUSER SET NAME = @N, NOTE = @NO, SIMAGEID = @IM, USERMODIFIEDID = @A, TIMEMODIFIED = @T WHERE ID = @I",
+                        "@N", g.Name.Trim(), "@NO", g.Note ?? "", "@IM", string.IsNullOrEmpty(g.ImageId) ? null : g.ImageId,
+                        "@A", actorId, "@T", now, "@I", id);
+                }
+            });
+            return id;
+        }
+
+        /// <summary>Số tài khoản còn thuộc nhóm (dòng quyền SGROUPROLE/SREPORTROLE đi theo nhóm nên không tính).</summary>
+        public int CountReferences(string groupId)
+        {
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+                return ReferenceChecker.Count(conn, null, "SGROUPUSERID", groupId, "SGROUPROLE", "SREPORTROLE");
+        }
+
+        /// <summary>Xóa nhóm cùng toàn bộ dòng quyền của nó. Người gọi kiểm tra CountReferences trước.</summary>
+        public void Delete(string groupId)
+        {
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DbHelper.Exec(conn, tx, "DELETE FROM SGROUPROLE WHERE SGROUPUSERID = @G", "@G", groupId);
+                DbHelper.Exec(conn, tx, "DELETE FROM SREPORTROLE WHERE SGROUPUSERID = @G", "@G", groupId);
+                DbHelper.Exec(conn, tx, "DELETE FROM SGROUPUSER WHERE ID = @G", "@G", groupId);
+            });
+        }
+    }
+}
