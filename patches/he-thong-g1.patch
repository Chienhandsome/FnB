+using System;
+using System.Collections.Generic;
+using System.Data;
+using FirebirdSql.Data.FirebirdClient;
+
+namespace Kazuko_FnB.Data
+{
+    public sealed class ImageRecord
+    {
+        public string Id { get; set; }
+        public string Name { get; set; }
+        public byte[] Data { get; set; }
+    }
+
+    /// <summary>Thư viện ảnh dùng chung (SIMAGE). Các bảng khác trỏ tới bằng cột SIMAGEID.</summary>
+    public sealed class ImageRepository
+    {
+        private readonly string _databasePath;
+
+        public ImageRepository(string databasePath)
+        {
+            _databasePath = databasePath;
+        }
+
+        /// <summary>Mọi ảnh, theo thứ tự tạo (ảnh cùng tên đứng cạnh nhau).</summary>
+        public List<ImageRecord> LoadAll()
+        {
+            var list = new List<ImageRecord>();
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT ID, NAME, IMAGE FROM SIMAGE WHERE STATUS = 30 ORDER BY TIMECREATED, NAME");
+                foreach (DataRow r in dt.Rows)
+                    list.Add(new ImageRecord { Id = DbHelper.Str(r[0]), Name = DbHelper.Str(r[1]) ?? "", Data = r[2] as byte[] });
+            }
+            return list;
+        }
+
+        public byte[] Get(string id)
+        {
+            if (string.IsNullOrEmpty(id))
+                return null;
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+                return DbHelper.Scalar(conn, null, "SELECT IMAGE FROM SIMAGE WHERE ID = @I", "@I", id) as byte[];
+        }
+
+        public string Add(string name, byte[] data, string userId)
+        {
+            string id = DbHelper.NewId();
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DbHelper.Exec(conn, tx,
+                    "INSERT INTO SIMAGE (ID, NAME, STATUS, USERCREATEDID, TIMECREATED, IMAGE) " +
+                    "VALUES (@I, @N, 30, @U, @T, @D)",
+                    "@I", id, "@N", name, "@U", userId, "@T", DbHelper.Now(), "@D", data);
+            });
+            return id;
+        }
+
+        public void Replace(string id, byte[] data, string userId)
+        {
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DbHelper.Exec(conn, tx,
+                    "UPDATE SIMAGE SET IMAGE = @D, USERMODIFIEDID = @U, TIMEMODIFIED = @T WHERE ID = @I",
+                    "@D", data, "@U", userId, "@T", DbHelper.Now(), "@I", id);
+            });
+        }
+
+        public void Rename(string id, string name, string userId)
+        {
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DbHelper.Exec(conn, tx,
+                    "UPDATE SIMAGE SET NAME = @N, USERMODIFIEDID = @U, TIMEMODIFIED = @T WHERE ID = @I",
+                    "@N", name, "@U", userId, "@T", DbHelper.Now(), "@I", id);
+            });
+        }
+
+        /// <summary>Số bản ghi (ở mọi bảng) còn dùng ảnh này.</summary>
+        public int CountUsage(string id)
+        {
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+                return ReferenceChecker.Count(conn, null, "SIMAGEID", id);
+        }
+
+        /// <summary>Xóa hẳn dòng ảnh. Người gọi phải kiểm tra CountUsage trước.</summary>
+        public void Delete(string id)
+        {
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DbHelper.Exec(conn, tx, "DELETE FROM SIMAGE WHERE ID = @I", "@I", id);
+            });
+        }
+    }
+}
diff --git a/Kazuko_FnB/Data/ReferenceChecker.cs b/Kazuko_FnB/Data/ReferenceChecker.cs
new file mode 100644
index 0000000..8c3a32f
--- /dev/null
+++ b/Kazuko_FnB/Data/ReferenceChecker.cs
@@ -0,0 +1,45 @@
+using System;
+using System.Collections.Generic;
+using System.Data;
+using System.Text.RegularExpressions;
+using FirebirdSql.Data.FirebirdClient;
+
+namespace Kazuko_FnB.Data
+{
+    /// <summary>
+    /// Đếm bản ghi còn tham chiếu tới một dòng danh mục trước khi xóa (DB không có khóa ngoại nên chương trình tự kiểm).
+    /// Tìm mọi bảng có cột <c>column</c> (ví dụ SIMAGEID, SGROUPUSERID, DNHOMKHACHHANGID) rồi đếm theo ID.
+    /// Bảng nằm trong <c>ignoreTables</c> (ví dụ dòng quyền đi theo nhóm) không tính.
+    /// </summary>
+    public static class ReferenceChecker
+    {
+        private static readonly Regex Identifier = new Regex("^[A-Za-z][A-Za-z0-9_]*$");
+
+        public static int Count(FbConnection conn, FbTransaction tx, string column, string id, params string[] ignoreTables)
+        {
+            if (!Identifier.IsMatch(column))
+                throw new ArgumentException("Tên cột không hợp lệ", "column");
+            var ignore = new HashSet<string>(ignoreTables ?? new string[0], StringComparer.OrdinalIgnoreCase);
+            DataTable tables = DbHelper.Table(conn, tx,
+                "SELECT TRIM(F.RDB$RELATION_NAME) FROM RDB$RELATION_FIELDS F " +
+                "JOIN RDB$RELATIONS R ON R.RDB$RELATION_NAME = F.RDB$RELATION_NAME " +
+                "WHERE R.RDB$SYSTEM_FLAG = 0 AND R.RDB$VIEW_BLR IS NULL AND TRIM(F.RDB$FIELD_NAME) = @C", "@C", column);
+            int total = 0;
+            foreach (DataRow r in tables.Rows)
+            {
+                string table = DbHelper.Str(r[0]);
+                if (string.IsNullOrEmpty(table) || ignore.Contains(table) || !Identifier.IsMatch(table))
+                    continue;
+                object n = DbHelper.Scalar(conn, tx, "SELECT COUNT(*) FROM " + table + " WHERE " + column + " = @I", "@I", id);
+                total += DbHelper.Int(n);
+            }
+            return total;
+        }
+
+        /// <summary>Thông báo chặn xóa (đúng chữ app gốc, hộp "Cảnh báo").</summary>
+        public static string BlockedMessage(string kind, string name, int count)
+        {
+            return "Bạn không thể xóa " + kind + " '" + name + "' vì còn (" + count + ") dữ liệu khác liên kết tới '" + name + "'";
+        }
+    }
+}
diff --git a/Kazuko_FnB/Data/RoleRepository.cs b/Kazuko_FnB/Data/RoleRepository.cs
new file mode 100644
index 0000000..a11977f
--- /dev/null
+++ b/Kazuko_FnB/Data/RoleRepository.cs
@@ -0,0 +1,150 @@
+using System;
+using System.Collections.Generic;
+using System.Data;
+using FirebirdSql.Data.FirebirdClient;
+
+namespace Kazuko_FnB.Data
+{
+    /// <summary>Một chức năng (SFUNCTION) hiển thị trong ma trận phân quyền.</summary>
+    public sealed class FunctionRow
+    {
+        public string Id { get; set; }
+        public string Name { get; set; }
+        public string GroupName { get; set; }
+        /// <summary>Chức năng chỉ có quyền Có/Không (SFUNCTION.NOTE = 'View'): chỉ có cột Khóa + Xem.</summary>
+        public bool ViewOnly { get; set; }
+    }
+
+    /// <summary>Một báo cáo hoặc thư mục báo cáo (SREPORT) cho phân quyền xem báo cáo.</summary>
+    public sealed class ReportRow
+    {
+        public string Id { get; set; }
+        public string Name { get; set; }
+        public string ParentId { get; set; }
+        public bool IsFolder { get; set; }
+    }
+
+    /// <summary>
+    /// Phân quyền theo nhóm: quyền sử dụng chức năng (SGROUPROLE.MODE = cờ bit Xem 0x10, Sửa 0x20, Thêm 0x40, Xóa 0x80,
+    /// 0 = khóa) và quyền xem báo cáo (SREPORTROLE, có dòng MODE = 30 là được xem).
+    /// </summary>
+    public sealed class RoleRepository
+    {
+        public const int ReportAllowed = 30;
+
+        private readonly string _databasePath;
+
+        public RoleRepository(string databasePath)
+        {
+            _databasePath = databasePath;
+        }
+
+        public List<FunctionRow> LoadFunctions()
+        {
+            var list = new List<FunctionRow>();
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT ID, NAME, GROUPNAME, NOTE FROM SFUNCTION WHERE STATUS = 30 ORDER BY GROUPNAME, NAME");
+                foreach (DataRow r in dt.Rows)
+                    list.Add(new FunctionRow
+                    {
+                        Id = DbHelper.Str(r[0]),
+                        Name = DbHelper.Str(r[1]) ?? "",
+                        GroupName = DbHelper.Str(r[2]) ?? "",
+                        ViewOnly = string.Equals((DbHelper.Str(r[3]) ?? "").Trim(), "View", StringComparison.OrdinalIgnoreCase)
+                    });
+            }
+            return list;
+        }
+
+        /// <summary>Cờ quyền của nhóm theo từng chức năng (không có dòng = 0).</summary>
+        public Dictionary<string, int> LoadModes(string groupId)
+        {
+            var map = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT SFUNCTIONID, MAX(COALESCE(MODE, 0)) FROM SGROUPROLE WHERE SGROUPUSERID = @G GROUP BY SFUNCTIONID", "@G", groupId);
+                foreach (DataRow r in dt.Rows)
+                    map[DbHelper.Str(r[0])] = DbHelper.Int(r[1]);
+            }
+            return map;
+        }
+
+        /// <summary>Ghi cờ quyền của nhóm cho các chức năng (cập nhật dòng có sẵn, chưa có thì thêm). Một transaction.</summary>
+        public void SaveModes(string groupId, IDictionary<string, int> modes, string actorId)
+        {
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DateTime now = DbHelper.Now();
+                foreach (KeyValuePair<string, int> kv in modes)
+                {
+                    int n = DbHelper.Exec(conn, tx,
+                        "UPDATE SGROUPROLE SET MODE = @M, USERMODIFIEDID = @A, TIMEMODIFIED = @T WHERE SGROUPUSERID = @G AND SFUNCTIONID = @F",
+                        "@M", kv.Value, "@A", actorId, "@T", now, "@G", groupId, "@F", kv.Key);
+                    if (n == 0 && kv.Value != 0)
+                    {
+                        DbHelper.Exec(conn, tx,
+                            "INSERT INTO SGROUPROLE (ID, STATUS, USERCREATEDID, TIMECREATED, SGROUPUSERID, SFUNCTIONID, MODE) VALUES (@I, 30, @A, @T, @G, @F, @M)",
+                            "@I", DbHelper.NewId(), "@A", actorId, "@T", now, "@G", groupId, "@F", kv.Key, "@M", kv.Value);
+                    }
+                }
+            });
+        }
+
+        // ------------------------------------------------------------------ xem báo cáo
+
+        public List<ReportRow> LoadReports()
+        {
+            var list = new List<ReportRow>();
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT ID, NAME, PARENTID, ITEMTYPE FROM SREPORT WHERE STATUS = 30 ORDER BY SORTORDER, NAME");
+                foreach (DataRow r in dt.Rows)
+                    list.Add(new ReportRow
+                    {
+                        Id = DbHelper.Str(r[0]),
+                        Name = DbHelper.Str(r[1]) ?? "",
+                        ParentId = DbHelper.Str(r[2]) ?? "",
+                        IsFolder = DbHelper.Int(r[3]) == 1
+                    });
+            }
+            return list;
+        }
+
+        /// <summary>ID các báo cáo mà nhóm được phép xem.</summary>
+        public HashSet<string> LoadAllowedReports(string groupId)
+        {
+            var set = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+            using (FbConnection conn = KazukoConnection.Open(_databasePath))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT SREPORTID FROM SREPORTROLE WHERE SGROUPUSERID = @G AND COALESCE(MODE, 0) = " + ReportAllowed, "@G", groupId);
+                foreach (DataRow r in dt.Rows)
+                    set.Add(DbHelper.Str(r[0]));
+            }
+            return set;
+        }
+
+        /// <summary>Cho/không cho nhóm xem các báo cáo. Cho xem = có dòng MODE 30; không cho = xóa dòng.</summary>
+        public void SetReportsAllowed(string groupId, IEnumerable<string> reportIds, bool allowed, string actorId)
+        {
+            DbHelper.InTransaction(_databasePath, delegate (FbConnection conn, FbTransaction tx)
+            {
+                DateTime now = DbHelper.Now();
+                foreach (string rid in reportIds)
+                {
+                    DbHelper.Exec(conn, tx, "DELETE FROM SREPORTROLE WHERE SGROUPUSERID = @G AND SREPORTID = @R", "@G", groupId, "@R", rid);
+                    if (allowed)
+                    {
+                        DbHelper.Exec(conn, tx,
+                            "INSERT INTO SREPORTROLE (ID, STATUS, MODE, USERCREATEDID, TIMECREATED, SGROUPUSERID, SREPORTID) VALUES (@I, 30, @M, @A, @T, @G, @R)",
+                            "@I", DbHelper.NewId(), "@M", ReportAllowed, "@A", actorId, "@T", now, "@G", groupId, "@R", rid);
+                    }
+                }
+            });
+        }
+    }
+}
diff --git a/Kazuko_FnB/Data/SelfTest.cs b/Kazuko_FnB/Data/SelfTest.cs
new file mode 100644
index 0000000..64ef3eb
--- /dev/null
+++ b/Kazuko_FnB/Data/SelfTest.cs
@@ -0,0 +1,398 @@
+using System;
+using System.Collections.Generic;
+using System.Data;
+using System.IO;
+using System.Text;
+using FirebirdSql.Data.FirebirdClient;
+using Kazuko_FnB.Services;
+
+namespace Kazuko_FnB.Data
+{
+    /// <summary>
+    /// Kiểm thử tự động nhóm Hệ thống trên BẢN SAO DATA.FDB (lệnh --selftest &lt;db&gt; &lt;file kết quả&gt;).
+    /// Chạy các ca trong docs/specs/he-thong.md mục 6; so sánh schema trước/sau để chứng minh không có DDL.
+    /// Không bao giờ chạy trên file gốc: người chạy phải truyền bản sao.
+    /// </summary>
+    public static class SelfTest
+    {
+        private static readonly List<string> Lines = new List<string>();
+        private static int _pass, _fail;
+
+        private static void Check(string name, bool ok, string detail = null)
+        {
+            if (ok) _pass++; else _fail++;
+            Lines.Add((ok ? "PASS " : "FAIL ") + name + (string.IsNullOrEmpty(detail) ? "" : "  [" + detail + "]"));
+        }
+
+        public static int Run(string databasePath, string outFile)
+        {
+            Lines.Clear();
+            _pass = 0;
+            _fail = 0;
+            try
+            {
+                AppSession.Current = new UserSession
+                {
+                    UserId = "selftest",
+                    UserName = "selftest",
+                    DisplayName = "selftest",
+                    IsAdmin = true,
+                    DatabasePath = databasePath,
+                    Permissions = new FunctionPermissions(true)
+                };
+                string schemaBefore = Schema(databasePath);
+
+                ConfigTests(databasePath);
+                RunExtra(databasePath);
+
+                string schemaAfter = Schema(databasePath);
+                Check("Không có DDL (schema trước = sau)", schemaBefore == schemaAfter);
+            }
+            catch (Exception ex)
+            {
+                Check("Ngoại lệ không mong đợi", false, ex.GetType().Name + ": " + ex.Message);
+            }
+            Lines.Add("");
+            Lines.Add("TỔNG: " + _pass + " đạt, " + _fail + " lỗi");
+            File.WriteAllText(outFile, string.Join(Environment.NewLine, Lines.ToArray()), Encoding.UTF8);
+            return _fail == 0 ? 0 : 1;
+        }
+
+        /// <summary>Danh sách bảng/cột người dùng (để so sánh trước/sau).</summary>
+        private static string Schema(string db)
+        {
+            using (FbConnection conn = KazukoConnection.Open(db))
+            {
+                DataTable dt = DbHelper.Table(conn, null,
+                    "SELECT TRIM(R.RDB$RELATION_NAME), TRIM(F.RDB$FIELD_NAME), F.RDB$FIELD_SOURCE " +
+                    "FROM RDB$RELATIONS R JOIN RDB$RELATION_FIELDS F ON F.RDB$RELATION_NAME = R.RDB$RELATION_NAME " +
+                    "WHERE R.RDB$SYSTEM_FLAG = 0 ORDER BY 1, 2");
+                var sb = new StringBuilder();
+                foreach (DataRow r in dt.Rows)
+                    sb.Append(r[0]).Append('.').Append(r[1]).Append(':').Append(r[2]).Append(';');
+                return sb.ToString();
+            }
+        }
+
+        // ------------------------------------------------------------------ H3 Cấu hình
+
+        private static readonly string[] SampleKeys =
+        {
+            "ChoPhepTrungTenKhachHang", "CachTinhDiem", "DoanhSoTuongUngVoi1Diem", "TuDongNangCapThanhVienKhiDatHanMuc",
+            "SoFileSaoLuu", "LamTronTien", "CoTienGio", "KichHoatLuuVetHoatDong", "ThoiGianChoPhepHuyBill", "CompanyName"
+        };
+
+        private static void ConfigTests(string db)
+        {
+            SystemConfig.Reload(db);
+            using (FbConnection conn = KazukoConnection.Open(db))
+            {
+                foreach (string key in SampleKeys)
+                {
+                    DataTable dt = DbHelper.Table(conn, null,
+                        "SELECT DATATYPE, INTVALUE, TEXTVALUE FROM SCONFIG WHERE NAME = @N", "@N", key);
+                    if (dt.Rows.Count == 0)
+                    {
+                        Check("SystemConfig đọc " + key + " (không có dòng → mặc định)", SystemConfig.GetInt(key) == 0);
+                        continue;
+                    }
+                    int dataType = DbHelper.Int(dt.Rows[0][0]);
+                    if (dataType == 1)
+                        Check("SystemConfig đọc " + key, SystemConfig.GetText(key) == (DbHelper.Str(dt.Rows[0][2]) ?? ""));
+                    else
+                        Check("SystemConfig đọc " + key, SystemConfig.GetInt(key) == DbHelper.Int(dt.Rows[0][1]));
+                }
+            }
+
+            // Ghi và đọc lại: ô số, ô tích, ô chữ; rồi hoàn lại giá trị cũ.
+            var repo = new ConfigRepository(db);
+            int oldBackup = SystemConfig.GetInt("SoFileSaoLuu");
+            bool oldTrung = SystemConfig.GetBool("ChoPhepTrungTenKhachHang");
+            string oldCompany = SystemConfig.GetText("CompanyName");
+            int written = repo.Save(new[]
+            {
+                new ConfigChange { Name = "SoFileSaoLuu", DataType = 3, IntValue = 7 },
+                new ConfigChange { Name = "ChoPhepTrungTenKhachHang", DataType = 3, IntValue = oldTrung ? 0 : 30 },
+                new ConfigChange { Name = "CompanyName", DataType = 1, TextValue = "CÔNG TY THỬ NGHIỆM" },
+                new ConfigChange { Name = "KhongCoKhoaNay", DataType = 3, IntValue = 1 }
+            }, "selftest");
+            SystemConfig.Reload(db);
+            Check("Save ghi đúng số khóa (khóa chưa có dòng bị bỏ qua)", written == 3, "written=" + written);
+            Check("Ghi ô số", SystemConfig.GetInt("SoFileSaoLuu") == 7);
+            Check("Ghi ô tích 30/0", SystemConfig.GetBool("ChoPhepTrungTenKhachHang") == !oldTrung);
+            Check("Ghi ô chữ (tiếng Việt có dấu)", SystemConfig.GetText("CompanyName") == "CÔNG TY THỬ NGHIỆM");
+            repo.Save(new[]
+            {
+                new ConfigChange { Name = "SoFileSaoLuu", DataType = 3, IntValue = oldBackup },
+                new ConfigChange { Name = "ChoPhepTrungTenKhachHang", DataType = 3, IntValue = oldTrung ? 30 : 0 },
+                new ConfigChange { Name = "CompanyName", DataType = 1, TextValue = oldCompany }
+            }, "selftest");
+            SystemConfig.Reload(db);
+            Check("Hoàn lại giá trị cũ", SystemConfig.GetInt("SoFileSaoLuu") == oldBackup && SystemConfig.GetText("CompanyName") == oldCompany);
+
+            // ViewModel: sửa một ô tích + một ô số → IsDirty → Save → đọc lại → hoàn lại.
+            var vm = new ConfigViewModel(db);
+            Check("ViewModel mới nạp chưa có thay đổi", !vm.IsDirty);
+            bool oldGiam = (bool)vm.Get("ChoPhepNhapGiamGia");
+            decimal oldHuy = (decimal)vm.Get("ThoiGianChoPhepHuyBill");
+            vm.Set("ChoPhepNhapGiamGia", !oldGiam);
+            vm.Set("ThoiGianChoPhepHuyBill", oldHuy + 5m);
+            Check("ViewModel báo có thay đổi", vm.IsDirty);
+            int n = vm.Save("selftest");
+            Check("ViewModel ghi đúng 2 khóa", n == 2, "n=" + n);
+            Check("Sau Save SystemConfig thấy giá trị mới", SystemConfig.GetBool("ChoPhepNhapGiamGia") == !oldGiam && SystemConfig.GetInt("ThoiGianChoPhepHuyBill") == (int)oldHuy + 5);
+            Check("Sau Save không còn thay đổi", !vm.IsDirty);
+            vm.Set("ChoPhepNhapGiamGia", oldGiam);
+            vm.Set("ThoiGianChoPhepHuyBill", oldHuy);
+            vm.Save("selftest");
+            Check("Hoàn lại qua ViewModel", SystemConfig.GetBool("ChoPhepNhapGiamGia") == oldGiam && SystemConfig.GetInt("ThoiGianChoPhepHuyBill") == (int)oldHuy);
+            Check("Khóa giao diện cũ không hiện trên màn", vm.AllItems.TrueForAll(i => i.Name != "GiaoDienChuongTrinh" && i.Name != "DoToChuHienThi"));
+
+            List<ConfigGroup> groups = repo.LoadVisibleGroups();
+            Check("Nhóm hiển thị không có nhóm Ẩn", groups.Count > 0 && !groups.Exists(g => g.Name == "Ẩn"), "n=" + groups.Count);
+            List<ConfigItem> items = repo.LoadItems();
+            var badCombo = items.FindAll(i => i.Control == ConfigControl.Combo && i.ComboItems.Length == 0);
+            Check("Mọi ô combo có danh sách mục", badCombo.Count == 0, string.Join(",", badCombo.ConvertAll(i => i.Name).ToArray()));
+            Check("Khóa nội bộ (không nhãn) không hiện", !items.Exists(i => i.Name == "SharedCode" || i.Name == "CompliedCode" || i.Name == "DatabaseVersion"));
+        }
+
+        // Các bước sau (ảnh, người dùng, quyền, mật khẩu) đăng ký thêm ở đây.
+        private static void RunExtra(string db)
+        {
+            ImageTests(db);
+            UserTests(db);
+            RoleTests(db);
+            PasswordTests(db);
+        }
+
+        // ------------------------------------------------------------------ H5 Đổi mật khẩu
+
+        private static void PasswordTests(string db)
+        {
+            Check("Mật khẩu cũ sai → chặn", PasswordPolicy.Check("abc", "x", "n", "n") == PasswordCheck.WrongOld);
+            Check("Nhập lại không khớp → chặn", PasswordPolicy.Check("abc", "abc", "n1", "n2") == PasswordCheck.Mismatch);
+            Check("Mới trùng cũ → chặn", PasswordPolicy.Check("abc", "abc", "abc", "abc") == PasswordCheck.SameAsOld);
+            Check("Mới để trống → hỏi xác nhận (cho phép)", PasswordPolicy.Check("abc", "abc", "", "") == PasswordCheck.EmptyNeedsConfirm);
+            Check("Admin mật khẩu rỗng đổi sang rỗng → trùng cũ, chặn", PasswordPolicy.Check("", "", "", "") == PasswordCheck.SameAsOld);
+            Check("Hợp lệ", PasswordPolicy.Check("abc", "abc", "mới 1", "mới 1") == PasswordCheck.Ok);
+            Check("Phân biệt hoa thường", PasswordPolicy.Check("abc", "ABC", "n", "n") == PasswordCheck.WrongOld);
+            Check("Không giới hạn độ dài tối thiểu (1 ký tự hợp lệ)", PasswordPolicy.Check("abcdef", "abcdef", "1", "1") == PasswordCheck.Ok);
+
+            var users = new UserAdminRepository(db);
+            var groups = new GroupRepository(db);
+            string gid = groups.Save(new GroupRow { Name = "NHÓM MẬT KHẨU" }, "selftest");
+            string uid = users.Save(new UserRow { Name = "MK THỬ", UserName = "mk.thu", Password = "cu", GroupId = gid }, new string[0], "selftest");
+            users.SetPassword(uid, "moi", "selftest");
+            Check("Đổi mật khẩu ghi vào DB (chữ thường)", users.GetPassword(uid) == "moi");
+            users.Delete(uid);
+            groups.Delete(gid);
+        }
+
+        // ------------------------------------------------------------------ H2 Phân quyền
+
+        private static void RoleTests(string db)
+        {
+            // Quy tắc đổi cờ.
+            Check("RoleLogic: tích Thêm kéo theo Xem (0x50)", RoleLogic.SetBit(0, RoleModes.Add, true) == 0x50);
+            Check("RoleLogic: bỏ Xem = khóa", RoleLogic.SetBit(0xF0, RoleModes.View, false) == 0);
+            Check("RoleLogic: bỏ ô Khóa → Xem (0x10)", RoleLogic.SetLocked(0, false) == 0x10);
+            Check("RoleLogic: tích Khóa → 0", RoleLogic.SetLocked(0xF0, true) == 0);
+            Check("RoleLogic: Tất cả = 0xF0; chức năng chỉ-xem = 0x10", RoleLogic.SetAll(0x10, true, false) == 0xF0 && RoleLogic.SetAll(0, true, true) == 0x10);
+            Check("RoleLogic: bỏ Sửa giữ Xem + Thêm", RoleLogic.SetBit(0x70, RoleModes.Edit, false) == 0x50);
+
+            var roles = new RoleRepository(db);
+            var groups = new GroupRepository(db);
+            var users = new UserAdminRepository(db);
+            List<FunctionRow> funcs = roles.LoadFunctions();
+            Check("Đủ 81 chức năng trong ma trận", funcs.Count == 81, "n=" + funcs.Count);
